<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--### WORKER DRONE ###-->
<!--Screen Eyes-->
  <VREAndroids.AndroidGeneDef ParentName="MD_DroneEyesBase">
  	<defName>MD_DisplayEyes</defName>
  	<label>display eyes</label>
  	<description>Vibrant display with 2 eyes.</description>
  	<iconPath>UI/Icons/Genes/Gene_WorkerDroneDisplay</iconPath>
	<geneClass>WorkerDronesMod.Gene_HediffSwitcherActivator</geneClass>
  	<selectionWeight>0</selectionWeight>
    <modExtensions>
		<li Class="WorkerDronesMod.GeneHediffSwitcherExtension">
		<stateHediffs>
			<li>
			<state>Normal</state>
			<hediffDef>MD_Normal_DisplayEyes</hediffDef>
			</li>
			<li>
			<state>HighHeat</state>
			<hediffDef>MD_HighHeat_DisplayEyes</hediffDef>
			</li>
			<li>
			<state>Downed</state>
			<hediffDef>MD_Warning_DisplayEyes</hediffDef>
			</li>
			<li>
			<state>Sleeping</state>
			<hediffDef>MD_SleepMode_DisplayEyes</hediffDef>
			</li>
		</stateHediffs>
		</li>
		<li Class="WorkerDronesMod.GenePrerequisitesExtension">
			<prerequisiteGeneDefNames>
				<li>MD_DroneBody</li>
				<li>MD_MurderDroneBody</li>
			</prerequisiteGeneDefNames>
		</li>
		<li MayRequire="nals.facialanimation" Class="WorkerDronesMod.FacialAnimationCompat.GeneForcedFacetypesExtension">
			<raceTags>
				<li>MD_WorkerDroneBase</li>
			</raceTags>
			<forceMouthColorWhite>true</forceMouthColorWhite>
			<EyeColorMatchesSkinColor>true</EyeColorMatchesSkinColor>				
		</li>
  	</modExtensions>
		<renderNodeProperties>
			<!--Fatal Error when dead-->
    		<li Class="VEF.Graphics.PawnRenderNodeProperties_Omni">
				<nodeClass>VEF.Graphics.PawnRenderNode_Omni</nodeClass>
				<workerClass>PawnRenderNodeWorker_Eye</workerClass>
      			<conditionalGraphics>
					<alts>
						<li>
							<!--Fatal Error when dead-->
							<shader>Cutout</shader>
							<colorA>
								<color>(204,2,2)</color>
							</colorA>
        					<requirements>
          						<li>Dead</li>
        					</requirements>
							<texPath>Pawn/Display/DisplayEyesError/DisplayFatalError/DisplayFatalError</texPath>
						</li>
					</alts>
					<!--Blank Display-->
					<texPath>Pawn/Display/DisplayEyesBlank/DisplayEyesBlank</texPath>
      			</conditionalGraphics>
				<visibleFacing>
					<li>South</li>
				</visibleFacing>
				<parentTagDef>Head</parentTagDef>
				<drawSize>0.3</drawSize>
				<drawData>
					<defaultData>
						<layer>54</layer>
						<offset>(0, 0, 0)</offset>
					</defaultData>
				</drawData>
    		</li>
		</renderNodeProperties>
</VREAndroids.AndroidGeneDef>
<!--### ###-->

<!--### DISASSEMBLY DRONE ###-->
<VREAndroids.AndroidGeneDef ParentName="MD_DisassemblyDroneEyesBase">
  <defName>MD_DisplayEyes_DD</defName>
  <label>Disassembly Drone Display</label>
  <description>Display eyes that cycle to normal when not drafted, and alternate eyes when drafted. This specific display, shows an X when drafted or Hostile.</description>
  <iconPath>UI/Icons/Genes/Gene_MurderDroneDisplay</iconPath>
  <geneClass>WorkerDronesMod.Gene_HediffSwitcherActivator</geneClass>
  <selectionWeight>0</selectionWeight>

  <modExtensions>
    <li Class="WorkerDronesMod.GeneHediffSwitcherExtension">
      <stateHediffs>
        <li>
          <state>Normal</state>
          <hediffDef>MD_Normal_DisplayEyes</hediffDef>
        </li>
        <li>
          <state>Drafted</state>
          <hediffDef>MD_Drafted_DisplayEyes_DD</hediffDef>
		  <overrideMapping>true</overrideMapping>
        </li>
        <li>
          <state>HighHeat</state>
          <hediffDef>MD_HighHeat_DisplayEyes</hediffDef>
        </li>
        <li>
          <state>Downed</state>
          <hediffDef>MD_Warning_DisplayEyes</hediffDef>
        </li>
		<li>
          <state>Hostile</state>
          <hediffDef>MD_Drafted_DisplayEyes_DD</hediffDef>
        </li>
		<li>
          <state>Sleeping</state>
          <hediffDef>MD_SleepMode_DisplayEyes</hediffDef>
        </li>
      </stateHediffs>
    </li>
	<li Class="WorkerDronesMod.GenePrerequisitesExtension">
		<prerequisiteGeneDefNames>
			<li>MD_DroneBody</li>
			<li>MD_MurderDroneBody</li>
		</prerequisiteGeneDefNames>
	</li>
	<li Class="WorkerDronesMod.GeneResearchExtension">
    	<requiredResearch>MD_DisassemblyDroneTech</requiredResearch>
    </li>
		<li MayRequire="nals.facialanimation" Class="WorkerDronesMod.FacialAnimationCompat.GeneForcedFacetypesExtension">
			<EyeColorMatchesSkinColor>true</EyeColorMatchesSkinColor>	
			<raceTags>
				<li>MD_WorkerDroneBase</li>
				<li>MD_MurderDroneBase</li>
			</raceTags>
			<!--
			faceParts that are accepted are..
			Head, Skin, Mouth, Eye, Lid, and Skin.
			-->
			<raceTagOptions>
				<li>
					<raceTag>MD_WorkerDroneBase</raceTag>
					<facePart>Brow</facePart>
				</li>
				<li>
					<raceTag>MD_MurderDroneBase</raceTag>
					<facePart>Eye</facePart>
				</li>
				<li>
					<raceTag>MD_MurderDroneBase</raceTag>
					<facePart>Lid</facePart>
				</li>
			</raceTagOptions>
			<forceMouthColorWhite>true</forceMouthColorWhite>
		</li>
  	</modExtensions>
  <renderNodeProperties>
		<!--Fatal Error when dead-->
    	<li Class="VEF.Graphics.PawnRenderNodeProperties_Omni">
			<nodeClass>VEF.Graphics.PawnRenderNode_Omni</nodeClass>
			<workerClass>PawnRenderNodeWorker_Eye</workerClass>
      		<conditionalGraphics>
				<alts>
					<li>
						<!--Fatal Error when dead-->
						<shader>Cutout</shader>
						<colorA>
							<color>(204,2,2)</color>
						</colorA>
        				<requirements>
          					<li>Dead</li>
        				</requirements>
						<texPath>Pawn/Display/DisplayEyesError/DisplayFatalError/DisplayFatalError</texPath>
					</li>
				</alts>
				<!--Blank Display-->
				<texPath>Pawn/Display/DisplayEyesBlank/DisplayEyesBlank</texPath>
      		</conditionalGraphics>
			<visibleFacing>
				<li>South</li>
			</visibleFacing>
			<parentTagDef>Head</parentTagDef>
			<drawSize>0.3</drawSize>
			<side>Center</side>
			<drawData>
				<defaultData>
					<layer>54</layer>
					<offset>(0, 0, 0)</offset>
				</defaultData>
			</drawData>
    	</li>
  </renderNodeProperties>
</VREAndroids.AndroidGeneDef>

<!--### X.X Eyes ###-->
