<Defs>

	<VREAndroids.AndroidGeneDef ParentName="MD_DroneEyeColors">
    	<defName>MD_DisplayColor_Random</defName>
    	<label>random eye color</label>
    	<labelShortAdj>colors</labelShortAdj>
		<geneClass>WorkerDronesMod.Gene_RandomSkinColor</geneClass>
    	<description>Carriers of this gene have randomly generated eye and light colors.</description>
	    <iconPath>UI/Icons/Genes/Gene_RandomColor</iconPath>
    	<exclusionTags>
      		<li>EyeColor</li>
	  		<li>SkinColorOverride</li>
    	</exclusionTags>
		<biostatCpx>1</biostatCpx>
    	<randomChosen>true</randomChosen>
    	<randomBrightnessFactor>1</randomBrightnessFactor>
  	</VREAndroids.AndroidGeneDef>
	
