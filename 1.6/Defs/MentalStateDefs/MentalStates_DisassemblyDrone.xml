        <label>rebooting</label>
        <stateClass>WorkerDronesMod.MentalState_Rebooting</stateClass>
        <category>Misc</category>
        <minTicksBeforeRecovery>15000</minTicksBeforeRecovery>
        <maxTicksBeforeRecovery>25000</maxTicksBeforeRecovery>
        <recoveryMtbDays>0.2</recoveryMtbDays>
        <recoverFromCaptured>false</recoverFromCaptured>
        <recoverFromDowned>false</recoverFromDowned>
        <recoverFromCollapsingExhausted>false</recoverFromCollapsingExhausted>
