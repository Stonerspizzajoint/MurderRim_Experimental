<Defs>
<!--Normal State-->
	<HediffDef ParentName="MD_CosmeticDisplayBase">
		<defName>MD_Normal_DisplayEyes</defName>
		<extraTooltip>Normal</extraTooltip>
		<renderNodeProperties>
			<li Class="VEF.Graphics.PawnRenderNodeProperties_Omni">
				<nodeClass>VEF.Graphics.PawnRenderNode_Omni</nodeClass>
				<workerClass>PawnRenderNodeWorker_Eye</workerClass>
				<visibleFacing>
					<li>South</li>
					<li>East</li>
					<li>West</li>
				</visibleFacing>
      			<conditionalGraphics>
					<alts>
						<li>
							<!--Blank Display when dead or downed-->
        					<requirements>
          						<li>Dead</li>
        					</requirements>
							<texPath>Pawn/Display/DisplayEyesBlank/DisplayEyesBlank</texPath>
						</li>
					</alts>
					<!--Normal Display-->
					<shader>TransparentPostLight</shader>
					<colorA>
						<skinColor>true</skinColor>
					</colorA>
        			<texPaths>
          				<li>Pawn/Display/NewEyes/Normal/Unisex/normal</li>
          				<li>Pawn/Display/NewEyes/WornOut/Unisex/normal</li>
          				<li>Pawn/Display/NewEyes/WornOutTired/Unisex/normal</li>
        			</texPaths>
      			</conditionalGraphics>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<parentTagDef>Head</parentTagDef>
				<drawSize>1</drawSize>
				<side>Center</side>
				<drawData>
					<defaultData>
						<layer>54</layer>
						<offset>(0, 0, 0)</offset>
					</defaultData>
				</drawData>
			</li>
		</renderNodeProperties>
	</HediffDef>

<!--Sleep State-->
	<HediffDef ParentName="MD_CosmeticDisplayBase">
		<defName>MD_SleepMode_DisplayEyes</defName>
        <extraTooltip>Sleeping</extraTooltip>
		<renderNodeProperties>
			<li Class="VEF.Graphics.PawnRenderNodeProperties_Omni">
				<nodeClass>VEF.Graphics.PawnRenderNode_Omni</nodeClass>
				<workerClass>PawnRenderNodeWorker_Eye</workerClass>
				<visibleFacing>
					<li>South</li>
				</visibleFacing>
      			<conditionalGraphics>
					<alts>
						<li>
							<!--Blank Display when dead or downed-->
        					<requirements>
          						<li>Dead</li>
        					</requirements>
							<texPath>Pawn/Display/DisplayEyesBlank/DisplayEyesBlank</texPath>
						</li>
					</alts>
					<!--Normal Display-->
					<shader>TransparentPostLight</shader>
					<colorA>
						<skinColor>true</skinColor>
					</colorA>
        			<texPaths>
          				<li>Pawn/Display/DisplayEyesSleep/DisplaySleepMode</li>
        			</texPaths>
      			</conditionalGraphics>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<parentTagDef>Head</parentTagDef>
				<drawSize>0.3</drawSize>
				<side>Center</side>
				<drawData>
					<defaultData>
						<layer>54</layer>
						<offset>(0, 0, -0.04)</offset>
					</defaultData>
				</drawData>
			</li>
		</renderNodeProperties>
	</HediffDef>

<!--Downed State-->
	<HediffDef ParentName="MD_CosmeticDisplayBase">
		<defName>MD_Warning_DisplayEyes</defName>
        <extraTooltip>Downed</extraTooltip>
		<renderNodeProperties>
			<li Class="VEF.Graphics.PawnRenderNodeProperties_Omni">
