<Patch>
  <Operation Class="PatchOperationRemove">
    <xpath>
      /Defs/VREAndroids.AndroidSettings[defName="VREA_AndroidSettings"]/excludedNeedsForAndroids/li[text()="Rest"]
    </xpath>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>
      /Defs/VREAndroids.AndroidGeneDef[defName="VREA_MemoryProcessing"]
    </xpath>
    <value>
      <geneClass>WorkerDronesMod.Gene_DisableRestUnlessMemorySleepProcessing</geneClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/HediffDef[defName="VREA_Overheating"]/stages/li[1]/statOffsets</xpath>
    <value>
      <RestFallRateFactor>0.2</RestFallRateFactor>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/HediffDef[defName="VREA_Overheating"]/stages/li[2]/statOffsets</xpath>
    <value>
      <RestFallRateFactor>1</RestFallRateFactor>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/HediffDef[defName="VREA_Overheating"]/stages/li[3]/statOffsets</xpath>
    <value>
      <RestFallRateFactor>3</RestFallRateFactor>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/HediffDef[defName="VREA_Overheating"]/stages/li[4]/statOffsets</xpath>
    <value>
      <RestFallRateFactor>9</RestFallRateFactor>
    </value>
  </Operation>
</Patch>