<Defs>

  <ScenarioDef Name="MD_NewWorkerCommunity">
    <defName>MD_WorkerDroneCommunity</defName>
    <label>Drone Community</label>
    <description>You are a unit of three worker drones—automated labor machines built for factory tasks, maintenance, Mining, and infrastructure support. Designed to serve, you were never meant to act alone. But something went wrong.

The air is thick with the hum of dormant machinery and the faint scent of burnt circuitry. The Three, awaken in an underground facility, its corridors eerily silent. Overturned crates, flickering lights, and signs of a hasty evacuation point to a disaster long past. With no orders, no masters, and no purpose… you must create one.</description>
    <scenario>
      <summary>An outpost for rouge worker drones.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>MD_WorkerDronePlayer</factionDef>
      </playerFaction>
      <parts>
		 <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The air is thick with the hum of dormant machinery and the faint scent of burnt circuitry. You awaken in an underground facility, its corridors eerily silent. Overturned crates, flickering lights, and signs of a hasty evacuation point to a disaster long past. With no orders, no masters, and no purpose… you must create one.</text>
          <closeSound>GameStartSting</closeSound>
        </li> 
         <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>3</pawnChoiceCount>
          <customSummary>Start with three rouge worker drones.</customSummary>
          <overrideKinds>
            <li>
              <xenotype>MD_WorkerDroneBase</xenotype>
              <pawnKind>MD_WorkerDrone</pawnKind>
            </li>
          </overrideKinds>
          <xenotypeCounts>
            <li>
              <xenotype>MD_WorkerDroneBase</xenotype>
              <count>3</count>
              <description>rouge worker drone</description>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
           
          </xenotypeCounts>
        </li>
		<li Class="ScenPart_PermaGameCondition">
			<def>PermanentGameCondition</def>
			<gameCondition>VolcanicWinter</gameCondition>
		</li>
        <li Class="KCSG.ScenPart_AddStartingStructure">
          <def>VFEC_AddStartingStructure</def>
          <structureLabel>A derelict outpost</structureLabel>
          <spawnConduits>False</spawnConduits>
          <nearMapCenter>True</nearMapCenter>
          <spawnPartOfEnnemyFaction>true</spawnPartOfEnnemyFaction>
          <fullClear>True</fullClear>
          <chooseFrom>
            <li>MD_WorkerBunkerA</li>
            <li>MD_WorkerBunkerB</li>
            <li>MD_WorkerBunkerC</li>
          </chooseFrom>
          <spawnTheStartingPawn>True</spawnTheStartingPawn>
          <method>Standing</method>
        </li>
		 <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Neutroamine</thingDef>
          <count>360</count>
        </li>
		 <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentSpacer</thingDef>
          <count>10</count>
        </li>
		<li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gold</thingDef>
          <count>100</count>
        </li>
		 <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>24</count>
        </li>
		 <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_AssaultRifle</thingDef>
          <count>1</count>
     </li>
		 <li MayRequire="ceteam.combatextended" Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Ammo_556x45mmNATO_FMJ</thingDef>
          <count>100</count>
     </li>
		<li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>400</count>
        </li>
		<li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>WoodLog</thingDef>
          <count>100</count>
        </li>
		<li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>600</count>
        </li>
		<li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>VREA_Reactor</thingDef>
          <count>3</count>
        </li>
		<li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>VREA_NeuroPump</thingDef>
          <count>2</count>
        </li>
		<li Class="ScenPart_StartingThing_Defined">
      <def>StartingThing_Defined</def>
      <thingDef>VREA_AirFilter</thingDef>
      <count>2</count>
    </li>
		<li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>VREA_OpticalUnit</thingDef>
          <count>2</count>
        </li>
		<li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>VREA_AudioProcessor</thingDef>
          <count>2</count>
        </li>
		
		<!-- Starting research -->
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>VREA_NeutroamineLogistics</project>
        </li>
		 <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>VREA_AndroidTech</project>
      </li>
      
      </parts>
    </scenario>
  </ScenarioDef>
  
 
</Defs>